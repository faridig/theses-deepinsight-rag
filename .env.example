# Configuration DeepInsight RAG

# --- API Keys ---
OPENAI_API_KEY=sk-...
COHERE_API_KEY=...
LLAMA_CLOUD_API_KEY=...

# --- Security (Chainlit) ---
# Obligatoire pour l'authentification. Générer avec `chainlit create-secret`
CHAINLIT_AUTH_SECRET=dev-secret-change-me-in-production-12345
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# --- Infrastructure & Hybrid LLM ---
QDRANT_URL=http://localhost:6333
USE_LOCAL_LLM=0
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=theses-data
MINIO_USE_SSL=False

# --- Observability & Dev ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
OTEL_SERVICE_NAME=theses-rag-ui
DISABLE_PHOENIX=0
IS_TESTING=0
